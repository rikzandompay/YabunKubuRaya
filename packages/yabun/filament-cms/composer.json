{
    "name": "yabun/filament-cms",
    "description": "Filament CMS plugin for Yayasan Bakti Umat Nusantara Pontianak",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rikzan El-Yasinta",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "Yabun\\FilamentCms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yabun\\FilamentCms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Yabun\\FilamentCms\\FilamentCmsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
